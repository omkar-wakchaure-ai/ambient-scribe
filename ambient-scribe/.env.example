# Copy this file to `.env` and fill in real values.
# NOTE: never commit the real `.env`; it is git-ignored.

# Backend: "groq" (hosted) or "ollama" (local, offline)
LLM_BACKEND=groq

# Required only if LLM_BACKEND=groq
GROQ_API_KEY=<your-groq-api-key>

# Optional: cap Groq output tokens per request. Free-tier keys reject
# requests above their per-minute output budget (e.g. 1000 OTPM), so a
# modest cap keeps the pipeline working. Raise it for higher tiers.
# GROQ_MAX_TOKENS=1000

# Optional, only used by the Ollama backend
# OLLAMA_HOST=http://localhost:11434
