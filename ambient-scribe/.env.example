# Copy this file to `.env` and fill in real values.
# NOTE: never commit the real `.env`; it is git-ignored.

# Backend: "groq" (hosted) or "ollama" (local, offline)
LLM_BACKEND=groq

# Required only if LLM_BACKEND=groq
GROQ_API_KEY=<your-groq-api-key>

# Optional: cap Groq output tokens per request. Free-tier keys reject
# requests above their per-minute output budget (e.g. 1000 OTPM), so a
# modest cap keeps the pipeline working. Raise it for higher tiers.
# GROQ_MAX_TOKENS=1000

# Optional, only used by the Ollama backend
# OLLAMA_HOST=http://localhost:11434

# Optional: comma-separated CORS allow-list for the FastAPI backend.
# Defaults to the React dev server (http://localhost:5173, http://127.0.0.1:5173).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for pyannote/speaker-diarization-3.1 (Hugging Face gated model).
# Create a read token at https://huggingface.co/settings/tokens and accept the
# model access terms at https://huggingface.co/pyannote/speaker-diarization-3.1.
# HF_TOKEN=hf_your_read_token
# HUGGINGFACE_TOKEN=hf_your_read_token
